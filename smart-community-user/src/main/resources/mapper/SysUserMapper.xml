<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smart.user.mapper.SysUserMapper">


    <select id="selectUserPage" resultType="com.smart.user.domain.vo.UserInfoVo">
        SELECT user_id,username,phone,status,email,
        FROM sys_user
        <where>
            <if test="dto.username != null and dto.username != ''">
                username LIKE CONCAT('%',#{dto.username},'%')
            </if>
        </where>
        LIMIT #{dto.pageNum}, #{dto.pageSize}
    </select>

    <select id="selectUserPageCount" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM sys_user
        <where>
            <if test="dto.username != null and dto.username != ''">
                username LIKE CONCAT('%',#{dto.username},'%')
            </if>
        </where>
    </select>

</mapper>
